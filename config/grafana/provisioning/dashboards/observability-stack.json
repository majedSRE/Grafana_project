{
  "annotations": {"list": []},
  "description": "Operational health dashboard for the observability platform, showing component health, Prometheus scrape behavior, and selected Prometheus internals.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "STACK HEALTH",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Targets Up",
      "description": "Number of expected observability scrape targets currently reporting up.",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(up{job=~\"prometheus|grafana|loki|tempo|cadvisor|linux-server|alloy\"} == 1)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 7}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Targets Down",
      "description": "Number of expected observability scrape targets currently down. Healthy state is zero.",
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(up{job=~\"prometheus|grafana|loki|tempo|cadvisor|linux-server|alloy\"} == 0) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "row",
      "title": "COMPONENT HEALTH",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Prometheus",
      "description": "Prometheus scrape endpoint health.",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"prometheus\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Grafana",
      "description": "Grafana metrics endpoint health.",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"grafana\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Loki",
      "description": "Loki metrics endpoint health.",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"loki\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Tempo",
      "description": "Tempo metrics endpoint health.",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"tempo\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Alloy",
      "description": "Grafana Alloy metrics endpoint health.",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"alloy\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "cAdvisor",
      "description": "cAdvisor container metrics endpoint health.",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"cadvisor\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Node Exporter",
      "description": "Node Exporter host metrics endpoint health.",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"linux-server\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "row",
      "title": "COMPONENT HEALTH — AGENTS",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "row",
      "title": "SCRAPE HEALTH",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Scrape Duration by Target",
      "description": "Time spent scraping the seven expected observability targets.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "scrape_duration_seconds{job=~\"prometheus|grafana|loki|tempo|cadvisor|linux-server|alloy\"}", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "Samples Scraped by Target",
      "description": "Number of samples returned by each expected observability target per scrape.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "scrape_samples_scraped{job=~\"prometheus|grafana|loki|tempo|cadvisor|linux-server|alloy\"}", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "row",
      "title": "PROMETHEUS INTERNALS",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active TSDB Series",
      "description": "Current number of active time-series held in the Prometheus TSDB head block.",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 33},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(prometheus_tsdb_head_series)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "value", "justifyMode": "center"}
    },
    {
      "type": "timeseries",
      "title": "Samples Appended",
      "description": "Prometheus sample append rate over the last five minutes.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 33},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(prometheus_tsdb_head_samples_appended_total[5m]))", "legendFormat": "samples/sec", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "Prometheus Query Activity",
      "description": "Prometheus query completion rate over the last five minutes, aggregated to avoid label-series noise.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 33},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(prometheus_engine_query_duration_seconds_count[5m]))", "legendFormat": "queries/sec", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 2, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ],
  "schemaVersion": 39,
  "tags": ["observability", "platform", "prometheus"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m"]},
  "refresh": "30s",
  "title": "Observability Stack",
  "uid": "observability-stack",
  "version": 1
}
