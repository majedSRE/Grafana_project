{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "text",
      "title": "Microservices",
      "gridPos": {"h": 2, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "Operational view of the retail journey. Start with service health, open a trace for the failing transaction, then use the trace ID to find the related Loki logs."
      }
    },
    {
      "type": "stat",
      "title": "Request rate",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 2},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"}
    },
    {
      "type": "stat",
      "title": "Error rate",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 2},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "100 * sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"}
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 2},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_seconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"}
    },
    {
      "type": "stat",
      "title": "Services reporting",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 2},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(count by (service_name) (traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"}
    },
    {
      "type": "timeseries",
      "title": "Request rate by service",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))", "legendFormat": "{{service_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by service",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_seconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m])))", "legendFormat": "{{service_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "type": "table",
      "title": "Service request summary",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))", "legendFormat": "{{service_name}}", "refId": "A", "format": "table", "instant": true},
        {"expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m]))", "legendFormat": "{{service_name}} errors", "refId": "B", "format": "table", "instant": true}
      ],
      "options": {"showHeader": true, "cellHeight": "sm"}
    },
    {
      "type": "table",
      "title": "Service dependencies",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (client, server, connection_type) (rate(traces_service_graph_request_total[5m]))", "refId": "A", "format": "table", "instant": true}],
      "options": {"showHeader": true, "cellHeight": "sm"}
    },
    {
      "type": "traces",
      "title": "Recent traces and transactions",
      "gridPos": {"h": 11, "w": 12, "x": 0, "y": 30},
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"queryType": "traceql", "query": "{ resource.service.name =~ \"$service\" }", "refId": "A"}],
      "options": {"showTable": true, "showSearch": true, "showTags": true}
    },
    {
      "type": "logs",
      "title": "Application logs",
      "gridPos": {"h": 11, "w": 12, "x": 12, "y": 30},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{log_type=\"application\",application=\"retail-store\",service=~\"ui|catalog|cart|checkout|orders\"}", "refId": "A"}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLines": true, "sortOrder": "Descending"}
    }
  ],
  "schemaVersion": 39,
  "tags": ["observability", "microservices", "apm"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "retail-ui,retail-catalog,retail-cart,retail-checkout,retail-orders",
        "current": {"text": "All", "value": ["$__all"]},
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "options": []
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "title": "Microservices Overview",
  "uid": "microservices-overview",
  "version": 3
}
