# Copy to .env on the monitoring VM after the manual host setup.
# No passwords belong in this file; Grafana reads its separate secret file.
MONITORING_PRIVATE_IP=10.20.0.4
SERVER_NAME=vm-monitoring-v2-test
ENVIRONMENT=test
OBSERVABILITY_DATA_DIR=/opt/observability-data
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana-admin-password
SLACK_WEBHOOK_FILE=/etc/octosight-slack-webhook
